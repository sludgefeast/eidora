root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.kt]
max_line_length = 120

# Wildcard imports are idiomatic in Compose – allow the common packages
ij_kotlin_packages_to_use_import_on_demand = androidx.compose.foundation.layout,androidx.compose.material3,androidx.compose.runtime,androidx.compose.foundation.lazy.grid,androidx.work,org.eidora.data.db,org.eidora.util,kotlinx.coroutines.flow

# Composable functions use PascalCase by Jetpack Compose convention
ktlint_standard_function-naming = disabled

# Wrapping rules conflict with readable Compose DSL code
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_wrapping = disabled
ktlint_standard_binary-expression-wrapping = disabled
ktlint_standard_condition-wrapping = disabled
ktlint_standard_property-wrapping = disabled
ktlint_standard_function-literal = disabled

[*.{yml,yaml}]
indent_size = 2
